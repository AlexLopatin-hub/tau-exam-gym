package exam

import "fmt"

type PageView struct {
	Title string
	Tab string
	Questions []Question
	Attempt *Attempt
	Blocks []AttemptBlock
	Error string
	Demo bool
}

type AttemptBlock struct {
	Topic string
	Questions []QuestionCardData
}

type QuestionCardData struct {
	AnchorID string
	Number int
	Question Question
	AttemptID string
	Finished bool
}

templ Page(view PageView) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Вопросы по ТАУ</title>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400..700&display=swap" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" crossorigin="anonymous"></script>
			<style>
				:root {
					color-scheme: light;
					font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
					color: #292923;
					background: #f4f1e9;
					font-synthesis: none;
				}
				body { margin: 0; min-height: 100vh; padding-bottom: 6rem; }
				a { color: #92502f; }
				nav { display: flex; gap: .25rem; }
				.tabs { margin: 0 0 1.4rem; border-bottom: 1px solid #e4ddd2; padding-bottom: .5rem; }
				.tabs a { padding: .48rem .8rem; border-radius: 7px; color: #6e6a60; font-size: .92rem; font-weight: 600; text-decoration: none; transition: background-color .15s, color .15s; }
				.tabs a:hover { background: #eae5da; color: #292923; }
				.tabs a[aria-current="page"] { background: #92502f; color: #fffdf8; }
				main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
				h1 { margin: 0 0 1.15rem; font-size: clamp(1.8rem, 3vw, 2.25rem); font-weight: 690; letter-spacing: -.035em; line-height: 1.15; }
				h3 { margin: 0 0 .45rem; font-size: 1.08rem; font-weight: 620; line-height: 1.45; }
				.block { margin: 2rem 0; }
				.block > h2 { margin-bottom: .9rem; border-bottom: 1px solid #dfd8cc; padding-bottom: .55rem; font-size: 1.2rem; font-weight: 650; letter-spacing: -.015em; }
				.card { margin: .85rem 0; border: 1px solid #e5dfd4; border-radius: 11px; padding: 1.1rem 1.2rem; background: #fffdf8; box-shadow: 0 1px 2px #332b1b0a; scroll-margin-top: 1rem; }
				.start-card { margin-top: 1.4rem; }
				.start-card p { margin: 0 0 1rem; color: #5f5b52; line-height: 1.55; }
				button { padding: .63rem .95rem; border: 0; border-radius: 7px; background: #92502f; color: #fffdf8; cursor: pointer; font: inherit; font-size: .94rem; font-weight: 650; transition: background-color .15s, box-shadow .15s; }
				button:hover { background: #783e24; }
				button:focus-visible, a:focus-visible, .answer-toggle:focus-visible { outline: 3px solid #c58a67; outline-offset: 3px; }
				.error { color: #9b3329; }
				.meta { margin: 0; color: #78746a; font-size: .84rem; }
				.answer { margin-top: 1rem; border-radius: 8px; padding: 1rem 1.1rem; line-height: 1.6; }
				.answer p { margin: .35rem 0 0; }
				.revealed { border: 1px solid #DEC2A9; background: #FAEBDD; color: #503523; }
				details.catalog-answer { margin-top: 1rem; }
				details.catalog-answer[open] summary { margin-bottom: 1rem; }
				details.catalog-answer summary { display: inline-block; list-style: none; }
				details.catalog-answer summary::-webkit-details-marker { display: none; }
				.answer-toggle { padding: .43rem .68rem; border: 1px solid #e3dbce; border-radius: 6px; background: #f1ede4; color: #665f54; cursor: pointer; font-size: .87rem; font-weight: 570; }
				.answer-toggle:hover { border-color: #d2c6b5; background: #e9e3d8; color: #3c382f; }
				details[open] .catalog-show, details:not([open]) .catalog-hide { display: none; }
				.finish-bar { position: fixed; z-index: 5; right: max(1rem, calc((100vw - 900px)/2)); bottom: calc(.75rem + env(safe-area-inset-bottom)); display: flex; width: max-content; max-width: calc(100vw - 2rem); box-sizing: border-box; border: 1px solid #e4ddd2; border-radius: 9px; padding: .3rem; background: #fffdf8eb; box-shadow: 0 3px 12px #332b1b17; }
				@media (max-width: 600px) {
					main { margin-top: 1rem; }
					.tabs a { flex: 1; padding: .58rem .4rem; text-align: center; }
					.card { padding: 1rem; }
					.finish-bar { right: 1rem; bottom: calc(.5rem + env(safe-area-inset-bottom)); }
				}
			</style>
		</head>
		<body>
			@Main(view)
			<script>
				(() => {
					const stateKey = node => `tau-exam:active:${node.dataset.attemptId}:${node.dataset.questionNumber}`;
					const getState = key => { try { return sessionStorage.getItem(key); } catch { return null; } };
					const setState = (key, value) => { try { sessionStorage.setItem(key, value); } catch {} };
					const init = (root) => {
						const nodes = [];
						if (root.matches && root.matches("details[data-attempt-id]")) nodes.push(root);
						nodes.push(...root.querySelectorAll("details[data-attempt-id]"));
						for (const node of nodes) {
							if (!node.dataset.attemptId) continue;
							const saved = getState(stateKey(node));
							if (saved !== null) node.open = saved === "1";
						}
					};
					document.addEventListener("toggle", event => {
						const node = event.target;
						if (node instanceof HTMLDetailsElement && node.dataset.attemptId) setState(stateKey(node), node.open ? "1" : "0");
					}, true);
					init(document);
					document.body.addEventListener("htmx:afterSwap", event => init(event.detail.target));
				})();
			</script>
		</body>
	</html>
}

templ Main(view PageView) {
	<main id="content">
		<nav class="tabs" aria-label="Основная навигация">
			if view.Tab == "exam" {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Экзамен</a>
			} else {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Экзамен</a>
			}
			if view.Tab == "questions" {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Все вопросы</a>
			} else {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Все вопросы</a>
			}
		</nav>
		<h1>Вопросы по ТАУ</h1>
		if view.Error != "" {
			<p class="error" role="alert">{ view.Error }</p>
		}
		if view.Attempt != nil {
			if view.Attempt.Finished {
				<p>Экзамен завершён. Ответы открыты для сверки.</p>
			} else {
				<p>В билете 30 вопросов из трёх тематических блоков. Открывайте ответы по одному или завершите экзамен, чтобы увидеть остальные.</p>
			}
			if !view.Attempt.Finished {
				<div class="finish-bar"><form method="post" action={ templ.URL("/exams/" + view.Attempt.ID + "/finish") }><button type="submit">Завершить экзамен</button></form></div>
			}
			for _, block := range view.Blocks {
				<section class="block">
					<h2>{ block.Topic }</h2>
					for _, q := range block.Questions {
						@QuestionCard(q)
					}
				</section>
			}
		} else if view.Tab == "questions" {
			if view.Demo {
				<p>Демонстрационный банк учебных вопросов.</p>
			} else {
				<p>В каталоге можно раскрывать и скрывать ответы.</p>
			}
			for _, q := range view.Questions {
				@QuestionCard(catalogCard(q))
			}
		} else {
			<section class="card start-card"><p>Тренировочный билет: 30 вопросов, по 10 из каждого тематического блока.</p><form method="post" action="/exams"><button type="submit">Начать экзамен</button></form></section>
		}
	</main>
}

templ QuestionCard(q QuestionCardData) {
	<article class="card" id={ q.AnchorID }>
		if q.Number > 0 {
			<h3>{ fmt.Sprintf("%d. %s", q.Number, q.Question.Text) }</h3>
		} else {
			<h3>{ q.Question.Text }</h3>
		}
		<p class="meta">{ q.Question.Topic } · { q.Question.Difficulty }</p>
		if q.Finished {
			@AnswerBlock(q.Question.Answer)
		} else {
			<details class="catalog-answer" data-attempt-id={ q.AttemptID } data-question-number={ fmt.Sprint(q.Number) }>
				<summary class="answer-toggle"><span class="catalog-show">Показать ответ</span><span class="catalog-hide">Скрыть ответ</span></summary>
				@AnswerBlock(q.Question.Answer)
			</details>
		}
	</article>
}

templ AnswerBlock(answer string) {
	<div class="answer revealed"><strong>Правильный ответ</strong><p>{ answer }</p></div>
}
