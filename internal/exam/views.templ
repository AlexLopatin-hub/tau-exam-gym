package exam

import "fmt"

type PageView struct {
	Title string
	Tab string
	Questions []Question
	Attempt *Attempt
	ArchivedID string
	Blocks []AttemptBlock
	CurrentPage int
	TotalPages int
	Error string
	Demo bool
	Lectures []Lecture
	Lecture *Lecture
	LectureHTML string
}

type AttemptBlock struct {
	Topic string
	Questions []QuestionCardData
}

type QuestionCardData struct {
	AnchorID string
	Number int
	Question Question
	AttemptID string
	Finished bool
	UserAnswer string
}

type PageLink struct {
	Page int
	Label string
	AriaLabel string
	Class string
	Icon string
}

templ Page(view PageView) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Вопросы по ТАУ</title>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400..700&display=swap" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			@Main(view)
			<script src="/static/app.js"></script>
		</body>
	</html>
}

templ Main(view PageView) {
	<main id="content" hx-history-elt>
		<nav class="tabs" aria-label="Основная навигация"
			if view.Attempt != nil || view.ArchivedID != "" {
				hx-history="false"
			}
		>
			if view.Tab == "exam" {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Экзамен</a>
			} else {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Экзамен</a>
			}
			if view.Tab == "questions" {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Все вопросы</a>
			} else {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Все вопросы</a>
			}
			<a href="/lectures" hx-get="/lectures" hx-target="#content" hx-swap="outerHTML" hx-push-url="true"
				if view.Tab == "lectures" {
					aria-current="page"
				}
			>Конспекты</a>
		</nav>
		<h1>Вопросы по ТАУ</h1>
		if view.Error != "" {
			<p class="error" role="alert">{ view.Error }</p>
		}
		if view.Attempt != nil {
			if view.Attempt.Finished {
				<p>Экзамен завершён. Ответы открыты для сверки.</p>
				@templ.JSONScript("completed-attempt", view.Attempt)
				<p id="archive-status" class="error" role="status"></p>
			} else {
				<p>В билете 30 вопросов из трёх тематических блоков. Свой ответ можно изменить до завершения экзамена. Для сверки откройте правильный ответ под вопросом или весь ключ в конце.</p>
			}
			if !view.Attempt.Finished {
				<div class="finish-bar"><form id="finish-exam" method="post" action={ templ.URL("/exams/" + view.Attempt.ID + "/finish") }><button type="submit">Завершить экзамен</button></form></div>
			}
			@QuestionBlocks(view.Blocks)
		} else if view.ArchivedID != "" {
			<h2>Пройденный экзамен</h2>
			<p id="archived-date"></p>
			<div id="archived-exam" data-id={ view.ArchivedID }>Загрузка билета…</div>
			<a href="/">К списку экзаменов</a>
		} else if view.Tab == "lectures" {
			@LectureNotes(view.Lectures, view.Lecture, view.LectureHTML)
		} else if view.Tab == "questions" {
			if view.Demo {
				<p>Демонстрационный банк учебных вопросов.</p>
			} else {
				<p>В каталоге можно раскрывать и скрывать ответы.</p>
			}
			<div id="question-results">
				if len(view.Questions) == 0 {
					<p class="empty-state">В банке пока нет вопросов.</p>
				}
				for _, q := range view.Questions {
					@QuestionCard(catalogCard(q))
				}
			</div>
			if view.TotalPages > 1 {
				<nav class="pagination" aria-label="Страницы каталога">
					if view.CurrentPage > 1 {
						@PageNavLink(PageLink{Page: view.CurrentPage-1, Label: "Назад", AriaLabel: "Назад", Class: "edge-link", Icon: "‹"})
					}
					for page := 1; page <= view.TotalPages; page++ {
						if page == view.CurrentPage-1 && page > 2 {
							<span class="page-ellipsis" data-needed="true" aria-hidden="true">…</span>
						}
						if page == view.TotalPages && view.TotalPages > view.CurrentPage+2 {
							<span class="page-ellipsis" data-needed="true" aria-hidden="true">…</span>
						}
						if page == view.CurrentPage {
							<span class="page-number" aria-current="page" aria-label={ fmt.Sprintf("Страница %d", page) }>{ fmt.Sprint(page) }</span>
						} else {
							@PageNavLink(PageLink{Page: page, Label: fmt.Sprint(page), AriaLabel: fmt.Sprintf("Перейти на страницу %d", page), Class: pageLinkClass(page, view.CurrentPage, view.TotalPages)})
						}
					}
					if view.CurrentPage < view.TotalPages {
						@PageNavLink(PageLink{Page: view.CurrentPage+1, Label: "Далее", AriaLabel: "Далее", Class: "edge-link", Icon: "›"})
					}
					<span class="visually-hidden">Страница { fmt.Sprint(view.CurrentPage) } из { fmt.Sprint(view.TotalPages) }</span>
				</nav>
			}
		} else {
			<section class="card start-card"><p>Тренировочный билет: 30 вопросов, по 10 из каждого тематического блока.</p><form method="post" action="/exams"><button type="submit">Начать экзамен</button></form></section>
			if view.Tab == "exam" {
				<section class="exam-history">
					<h2>Пройденные экзамены</h2>
					<p id="history-status" class="empty-state">В этом браузере пока нет пройденных экзаменов.</p>
					<ul id="exam-history"></ul>
				</section>
			}
		}
	</main>
}

templ LectureNotes(lectures []Lecture, selected *Lecture, body string) {
	<div class="lecture-layout">
		if len(lectures) > 0 {
			<div class="lecture-sidebar">
				@LectureDates(lectures, selected)
			</div>
			<details class="lecture-picker">
				<summary>
					if selected != nil {
						Лекция { selected.Date }
					} else {
						Выбрать лекцию
					}
				</summary>
				@LectureDates(lectures, selected)
			</details>
		}
		if selected != nil {
			<article class="card lecture">
				<h2>Лекция { selected.Date }</h2>
				@templ.Raw(body)
			</article>
		}
	</div>
}

templ LectureDates(lectures []Lecture, selected *Lecture) {
	<nav class="lecture-dates" aria-label="Лекции по датам">
		for _, lecture := range lectures {
			<a href={ templ.URL("/lectures/" + lecture.ID) }
				hx-get={ "/lectures/" + lecture.ID } hx-target="#content" hx-swap="outerHTML" hx-push-url="true"
				if selected != nil && selected.ID == lecture.ID {
					aria-current="page"
				}
			>{ lecture.Date }</a>
		}
	</nav>
}

templ QuestionBlocks(blocks []AttemptBlock) {
	for _, block := range blocks {
		<section class="block">
			<h2>{ block.Topic }</h2>
			for _, q := range block.Questions {
				@QuestionCard(q)
			}
		</section>
	}
}

templ QuestionCard(q QuestionCardData) {
	<article class="card" id={ q.AnchorID }>
		if q.Number > 0 {
			<h3>{ fmt.Sprintf("%d. %s", q.Number, q.Question.Text) }</h3>
		} else {
			<h3>{ q.Question.Text }</h3>
		}
		<p class="meta">{ q.Question.Topic } · { q.Question.Difficulty }</p>
		if q.Finished {
			<div class="user-answer">
				<strong>Ваш ответ</strong>
				if q.UserAnswer == "" {
					<p>Ответ не указан.</p>
				} else {
					<p>{ q.UserAnswer }</p>
				}
			</div>
			@AnswerBlock(q.Question.Answer)
		} else {
			if q.AttemptID != "" {
				<label class="user-answer">Ваш ответ<span class="visually-hidden">{ fmt.Sprintf(" на вопрос %d", q.Number) }</span>
					<textarea rows="3" name={ q.Question.ID } form="finish-exam" data-draft-key={ fmt.Sprintf("tau-exam:active:%s:%d:draft", q.AttemptID, q.Number) }></textarea>
				</label>
			}
			<details class="catalog-answer">
				<summary class="answer-toggle"><span class="catalog-show">Показать ответ</span><span class="catalog-hide">Скрыть ответ</span></summary>
				@AnswerBlock(q.Question.Answer)
			</details>
		}
	</article>
}

templ AnswerBlock(answer string) {
	<div class="answer revealed"><strong>Правильный ответ</strong><p>{ answer }</p></div>
}

templ PageNavLink(link PageLink) {
	<a class={ link.Class } aria-label={ link.AriaLabel }
		href={ templ.URL(fmt.Sprintf("/questions?page=%d", link.Page)) }
		hx-get={ fmt.Sprintf("/questions?page=%d", link.Page) }
		hx-target="#content" hx-swap="outerHTML show:#question-results:top" hx-push-url="true">
		if link.Icon != "" {
			<span class="edge-icon" aria-hidden="true">{ link.Icon }</span><span class="edge-label">{ link.Label }</span>
		} else {
			{ link.Label }
		}
	</a>
}
