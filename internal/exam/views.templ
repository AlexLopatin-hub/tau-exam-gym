package exam

import "fmt"

type PageView struct {
	Title string
	Tab string
	Questions []Question
	Attempt *Attempt
	ArchivedID string
	Blocks []AttemptBlock
	CurrentPage int
	TotalPages int
	Error string
	Demo bool
}

type AttemptBlock struct {
	Topic string
	Questions []QuestionCardData
}

type QuestionCardData struct {
	AnchorID string
	Number int
	Question Question
	AttemptID string
	Finished bool
	UserAnswer string
}

type PageLink struct {
	Page int
	Label string
	AriaLabel string
	Class string
	Icon string
}

templ Page(view PageView) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Вопросы по ТАУ</title>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400..700&display=swap" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<style>
				:root {
					color-scheme: light;
					font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
					color: #292923;
					background: #f4f1e9;
					font-synthesis: none;
				}
				body { margin: 0; min-height: 100vh; padding-bottom: 6rem; }
				a { color: #92502f; }
				nav { display: flex; gap: .25rem; }
				.tabs { margin: 0 0 1.4rem; border-bottom: 1px solid #e4ddd2; padding-bottom: .5rem; }
				.tabs a { padding: .48rem .8rem; border-radius: 7px; color: #6e6a60; font-size: .92rem; font-weight: 600; text-decoration: none; transition: background-color .15s, color .15s; }
				.tabs a:hover { background: #eae5da; color: #292923; }
				.tabs a[aria-current="page"] { background: #92502f; color: #fffdf8; }
				main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
				h1 { margin: 0 0 1.15rem; font-size: clamp(1.8rem, 3vw, 2.25rem); font-weight: 690; letter-spacing: -.035em; line-height: 1.15; }
				h3 { margin: 0 0 .45rem; font-size: 1.08rem; font-weight: 620; line-height: 1.45; }
				.block { margin: 2rem 0; }
				.block > h2 { margin-bottom: .9rem; border-bottom: 1px solid #dfd8cc; padding-bottom: .55rem; font-size: 1.2rem; font-weight: 650; letter-spacing: -.015em; }
				.card { margin: .85rem 0; border: 1px solid #e5dfd4; border-radius: 11px; padding: 1.1rem 1.2rem; background: #fffdf8; box-shadow: 0 1px 2px #332b1b0a; scroll-margin-top: 1rem; }
				.start-card { margin-top: 1.4rem; }
				.exam-history { margin-top: 2.5rem; border-top: 1px solid #dfd8cc; }
				.exam-history ul { padding-left: 1.4rem; }
				.exam-history li { margin: .65rem 0; }
				.start-card p { margin: 0 0 1rem; color: #5f5b52; line-height: 1.55; }
				button { padding: .63rem .95rem; border: 0; border-radius: 7px; background: #92502f; color: #fffdf8; cursor: pointer; font: inherit; font-size: .94rem; font-weight: 650; transition: background-color .15s, box-shadow .15s; }
				button:hover { background: #783e24; }
				button:focus-visible, a:focus-visible, .answer-toggle:focus-visible { outline: 3px solid #c58a67; outline-offset: 3px; }
				.error { color: #9b3329; }
				.meta { margin: 0; color: #78746a; font-size: .84rem; }
				.answer { margin-top: 1rem; border-radius: 8px; padding: 1rem 1.1rem; line-height: 1.6; }
				.answer p { margin: .35rem 0 0; }
				.user-answer { margin-top: 1rem; display: block; }
				.user-answer textarea { display: block; margin-top: .4rem; width: 100%; box-sizing: border-box; resize: vertical; padding: .6rem; border: 1px solid #bcb4a6; border-radius: 6px; font: inherit; }
				.user-answer p { margin: .35rem 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }
				.revealed { border: 1px solid #DEC2A9; background: #FAEBDD; color: #503523; }
				details.catalog-answer { margin-top: 1rem; }
				details.catalog-answer[open] summary { margin-bottom: 1rem; }
				details.catalog-answer summary { display: inline-block; list-style: none; }
				details.catalog-answer summary::-webkit-details-marker { display: none; }
				.answer-toggle { padding: .43rem .68rem; border: 1px solid #e3dbce; border-radius: 6px; background: #f1ede4; color: #665f54; cursor: pointer; font-size: .87rem; font-weight: 570; }
				.answer-toggle:hover { border-color: #d2c6b5; background: #e9e3d8; color: #3c382f; }
				details[open] .catalog-show, details:not([open]) .catalog-hide { display: none; }
				.pagination { display: flex; flex-wrap: nowrap; align-items: center; justify-content: center; gap: .35rem; width: 100%; max-width: 100%; overflow: hidden; white-space: nowrap; }
				.pagination a, .pagination .page-number { display: inline-flex; flex: 0 0 auto; min-width: 2.15rem; height: 2.15rem; box-sizing: border-box; align-items: center; justify-content: center; padding: .25rem .45rem; border: 1px solid #e3dbce; border-radius: 6px; color: #665f54; background: #fffdf8; font-size: .9rem; font-weight: 600; text-decoration: none; }
				.pagination a:hover { background: #eae5da; color: #292923; }
				.pagination .compact-hidden { display: none; }
				.pagination.expanded .compact-hidden { display: inline-flex; }
				.pagination .page-ellipsis { display: none; }
				.pagination:not(.expanded) .page-ellipsis[data-needed="true"] { display: inline-flex; align-items: center; justify-content: center; min-width: 1.25rem; color: #78746a; }
				.pagination .page-number[aria-current="page"] { border-color: #92502f; background: #92502f; color: #fffdf8; }
				.pagination .edge-icon { display: none; }
				.pagination.compact-icons .edge-label { display: none; }
				.pagination.compact-icons .edge-icon { display: inline; }
				.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
				.empty-state { color: #78746a; }
				.finish-bar { position: fixed; z-index: 5; right: max(1rem, calc((100vw - 900px)/2)); bottom: calc(.75rem + env(safe-area-inset-bottom)); display: flex; width: max-content; max-width: calc(100vw - 2rem); box-sizing: border-box; border: 1px solid #e4ddd2; border-radius: 9px; padding: .3rem; background: #fffdf8eb; box-shadow: 0 3px 12px #332b1b17; }
				@media (max-width: 600px) {
					main { margin-top: 1rem; }
					.tabs a { flex: 1; padding: .58rem .4rem; text-align: center; }
					.card { padding: 1rem; }
					.finish-bar { right: 1rem; bottom: calc(.5rem + env(safe-area-inset-bottom)); }
				}
				@media (max-width: 480px) {
					.pagination { gap: .12rem; }
					.pagination a, .pagination .page-number { min-width: 1.8rem; height: 2rem; padding: .2rem .25rem; font-size: .86rem; }
				}
				@media (max-width: 350px) {
					.pagination { gap: .08rem; }
					.pagination a, .pagination .page-number { min-width: 1.45rem; height: 1.75rem; padding: .15rem .16rem; font-size: .8rem; }
					.pagination:not(.expanded) .page-ellipsis[data-needed="true"] { min-width: .55rem; }
				}
			</style>
		</head>
		<body>
			@Main(view)
			<script>
				(() => {
					const prefix = "tau-exam:completed:v1:";
					const dateLabel = new Intl.DateTimeFormat("ru-RU", {dateStyle: "long", timeStyle: "medium"});
					function readAttempt(id) {
						try {
							const a = JSON.parse(localStorage.getItem(prefix + id));
							if (a?.ID === id && Number.isFinite(Date.parse(a.FinishedAt)) && Array.isArray(a.Questions)) return a;
						} catch {}
						return null;
					}
					function showHistory(list) {
						const status = document.getElementById("history-status");
						list.replaceChildren();
						try {
							const attempts = Object.keys(localStorage).filter(key => key.startsWith(prefix))
								.map(key => readAttempt(key.slice(prefix.length))).filter(Boolean)
								.sort((a, b) => Date.parse(b.FinishedAt) - Date.parse(a.FinishedAt));
							status.hidden = attempts.length > 0;
							for (const a of attempts) {
								const link = document.createElement("a");
								link.href = "/?attempt=" + encodeURIComponent(a.ID);
								link.textContent = "Экзамен · " + dateLabel.format(new Date(a.FinishedAt));
								const item = document.createElement("li");
								item.append(link);
								list.append(item);
							}
						} catch {
							status.hidden = false;
							status.textContent = "История экзаменов недоступна в этом браузере.";
						}
					}
					async function showArchived(root) {
						const a = readAttempt(root.dataset.id);
						if (!a) {
							root.textContent = "Эта попытка не найдена в истории браузера.";
							return;
						}
						if (root.querySelector(".block")) return;
						document.getElementById("archived-date").textContent = dateLabel.format(new Date(a.FinishedAt));
						try {
							const response = await fetch("/archive/render", {
								method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(a)
							});
							if (!response.ok) throw new Error();
							root.innerHTML = await response.text();
						} catch {
							root.textContent = "Не удалось открыть архивный билет. Обновите страницу, чтобы попробовать снова.";
						}
					}
					function loadArchive() {
						const completed = document.getElementById("completed-attempt");
						if (completed) {
							try {
								const a = JSON.parse(completed.textContent);
								localStorage.setItem(prefix + a.ID, completed.textContent);
							} catch {
								document.getElementById("archive-status").textContent = "Не удалось сохранить экзамен в истории этого браузера.";
							}
						}
						const list = document.getElementById("exam-history");
						if (list) showHistory(list);
						const archived = document.getElementById("archived-exam");
						if (archived) showArchived(archived);
					}
					function fitPager() {
						const nav = document.querySelector(".pagination");
						if (!nav) return;
						nav.classList.remove("compact-icons");
						nav.classList.add("expanded");
						if (nav.scrollWidth > nav.clientWidth + 1) {
							nav.classList.remove("expanded");
							nav.classList.toggle("compact-icons", nav.scrollWidth > nav.clientWidth + 1);
						}
					}
					function init() {
						loadArchive();
						fitPager();
						try {
							for (const field of document.querySelectorAll("textarea[data-draft-key]")) {
								const saved = sessionStorage.getItem(field.dataset.draftKey);
								if (saved !== null) field.value = saved;
							}
						} catch {}
					}
					document.addEventListener("input", ({ target }) => {
						if (target.matches("textarea[data-draft-key]")) {
							try { sessionStorage.setItem(target.dataset.draftKey, target.value); } catch {}
						}
					});
					init();
					document.body.addEventListener("htmx:afterSwap", init);
					document.body.addEventListener("htmx:historyRestore", init);
					window.addEventListener("pageshow", event => { if (event.persisted) init(); });
					window.addEventListener("resize", fitPager);
					document.fonts.ready.then(fitPager);
					document.fonts.addEventListener("loadingdone", fitPager);
				})();
			</script>
		</body>
	</html>
}

templ Main(view PageView) {
	<main id="content" hx-history-elt>
		<nav class="tabs" aria-label="Основная навигация"
			if view.Attempt != nil || view.ArchivedID != "" {
				hx-history="false"
			}
		>
			if view.Tab == "exam" {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Экзамен</a>
			} else {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Экзамен</a>
			}
			if view.Tab == "questions" {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true" aria-current="page">Все вопросы</a>
			} else {
				<a href="/questions" hx-get="/questions" hx-target="#content" hx-swap="outerHTML" hx-push-url="true">Все вопросы</a>
			}
		</nav>
		<h1>Вопросы по ТАУ</h1>
		if view.Error != "" {
			<p class="error" role="alert">{ view.Error }</p>
		}
		if view.Attempt != nil {
			if view.Attempt.Finished {
				<p>Экзамен завершён. Ответы открыты для сверки.</p>
				@templ.JSONScript("completed-attempt", view.Attempt)
				<p id="archive-status" class="error" role="status"></p>
			} else {
				<p>В билете 30 вопросов из трёх тематических блоков. Свой ответ можно изменить до завершения экзамена. Для сверки откройте правильный ответ под вопросом или весь ключ в конце.</p>
			}
			if !view.Attempt.Finished {
				<div class="finish-bar"><form id="finish-exam" method="post" action={ templ.URL("/exams/" + view.Attempt.ID + "/finish") }><button type="submit">Завершить экзамен</button></form></div>
			}
			@QuestionBlocks(view.Blocks)
		} else if view.ArchivedID != "" {
			<h2>Пройденный экзамен</h2>
			<p id="archived-date"></p>
			<div id="archived-exam" data-id={ view.ArchivedID }>Загрузка билета…</div>
			<a href="/">К списку экзаменов</a>
		} else if view.Tab == "questions" {
			if view.Demo {
				<p>Демонстрационный банк учебных вопросов.</p>
			} else {
				<p>В каталоге можно раскрывать и скрывать ответы.</p>
			}
			<div id="question-results">
				if len(view.Questions) == 0 {
					<p class="empty-state">В банке пока нет вопросов.</p>
				}
				for _, q := range view.Questions {
					@QuestionCard(catalogCard(q))
				}
			</div>
			if view.TotalPages > 1 {
				<nav class="pagination" aria-label="Страницы каталога">
					if view.CurrentPage > 1 {
						@PageNavLink(PageLink{Page: view.CurrentPage-1, Label: "Назад", AriaLabel: "Назад", Class: "edge-link", Icon: "‹"})
					}
					for page := 1; page <= view.TotalPages; page++ {
						if page == view.CurrentPage-1 && page > 2 {
							<span class="page-ellipsis" data-needed="true" aria-hidden="true">…</span>
						}
						if page == view.TotalPages && view.TotalPages > view.CurrentPage+2 {
							<span class="page-ellipsis" data-needed="true" aria-hidden="true">…</span>
						}
						if page == view.CurrentPage {
							<span class="page-number" aria-current="page" aria-label={ fmt.Sprintf("Страница %d", page) }>{ fmt.Sprint(page) }</span>
						} else {
							@PageNavLink(PageLink{Page: page, Label: fmt.Sprint(page), AriaLabel: fmt.Sprintf("Перейти на страницу %d", page), Class: pageLinkClass(page, view.CurrentPage, view.TotalPages)})
						}
					}
					if view.CurrentPage < view.TotalPages {
						@PageNavLink(PageLink{Page: view.CurrentPage+1, Label: "Далее", AriaLabel: "Далее", Class: "edge-link", Icon: "›"})
					}
					<span class="visually-hidden">Страница { fmt.Sprint(view.CurrentPage) } из { fmt.Sprint(view.TotalPages) }</span>
				</nav>
			}
		} else {
			<section class="card start-card"><p>Тренировочный билет: 30 вопросов, по 10 из каждого тематического блока.</p><form method="post" action="/exams"><button type="submit">Начать экзамен</button></form></section>
			if view.Tab == "exam" {
				<section class="exam-history">
					<h2>Пройденные экзамены</h2>
					<p id="history-status" class="empty-state">В этом браузере пока нет пройденных экзаменов.</p>
					<ul id="exam-history"></ul>
				</section>
			}
		}
	</main>
}

templ QuestionBlocks(blocks []AttemptBlock) {
	for _, block := range blocks {
		<section class="block">
			<h2>{ block.Topic }</h2>
			for _, q := range block.Questions {
				@QuestionCard(q)
			}
		</section>
	}
}

templ QuestionCard(q QuestionCardData) {
	<article class="card" id={ q.AnchorID }>
		if q.Number > 0 {
			<h3>{ fmt.Sprintf("%d. %s", q.Number, q.Question.Text) }</h3>
		} else {
			<h3>{ q.Question.Text }</h3>
		}
		<p class="meta">{ q.Question.Topic } · { q.Question.Difficulty }</p>
		if q.Finished {
			<div class="user-answer">
				<strong>Ваш ответ</strong>
				if q.UserAnswer == "" {
					<p>Ответ не указан.</p>
				} else {
					<p>{ q.UserAnswer }</p>
				}
			</div>
			@AnswerBlock(q.Question.Answer)
		} else {
			if q.AttemptID != "" {
				<label class="user-answer">Ваш ответ<span class="visually-hidden">{ fmt.Sprintf(" на вопрос %d", q.Number) }</span>
					<textarea rows="3" name={ q.Question.ID } form="finish-exam" data-draft-key={ fmt.Sprintf("tau-exam:active:%s:%d:draft", q.AttemptID, q.Number) }></textarea>
				</label>
			}
			<details class="catalog-answer">
				<summary class="answer-toggle"><span class="catalog-show">Показать ответ</span><span class="catalog-hide">Скрыть ответ</span></summary>
				@AnswerBlock(q.Question.Answer)
			</details>
		}
	</article>
}

templ AnswerBlock(answer string) {
	<div class="answer revealed"><strong>Правильный ответ</strong><p>{ answer }</p></div>
}

templ PageNavLink(link PageLink) {
	<a class={ link.Class } aria-label={ link.AriaLabel }
		href={ templ.URL(fmt.Sprintf("/questions?page=%d", link.Page)) }
		hx-get={ fmt.Sprintf("/questions?page=%d", link.Page) }
		hx-target="#content" hx-swap="outerHTML show:#question-results:top" hx-push-url="true">
		if link.Icon != "" {
			<span class="edge-icon" aria-hidden="true">{ link.Icon }</span><span class="edge-label">{ link.Label }</span>
		} else {
			{ link.Label }
		}
	</a>
}
