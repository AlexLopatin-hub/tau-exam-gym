package views

import (
	"fmt"
	"strings"

	"github.com/AlexLopatin-hub/tau-exam-gym/internal/model"
)

type PageView struct {
	Title      string
	Tab        string
	Questions  []model.Question
	Attempt    *model.Attempt
	ArchivedID string
	Difficulty string
	Error      string
	Lectures   []model.Lecture
	Lecture    *model.Lecture
}

type QuestionCardData struct {
	AnchorID   string
	Number     int
	Question   model.Question
	AttemptID  string
	Finished   bool
	UserAnswer string
}

templ Page(view PageView) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Вопросы по ТАУ</title>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400..700&display=swap" rel="stylesheet"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.19.1/dist/katex.min.css" integrity="sha384-WwGtaC6ywCHxA5cstpj/3+xIZvTez8dq2IcBQaXRkenHZ7FVVq1ZROtURwfbtTlG" crossorigin="anonymous"/>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.19.1/dist/katex.min.js" integrity="sha384-a1WQdjRj162i159OYq041X6I4K8NenkrI09LlPmiHg0YOb7CR+wJOraXwK9abpnE" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.19.1/dist/contrib/auto-render.min.js" integrity="sha384-bjyGPfbij8/NDKJhSGZNP/khQVgtHUE5exjm4Ydllo42FwIgYsdLO2lXGmRBf5Mz" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			@Main(view)
			<script defer src="/static/app.js"></script>
		</body>
	</html>
}

templ Main(view PageView) {
	<main id="content" hx-history-elt>
		<nav
			class="tabs"
			aria-label="Основная навигация"
			if view.Attempt != nil || view.ArchivedID != "" {
				hx-history="false"
			}
		>
			<a
				href="/"
				hx-get="/"
				hx-target="#content"
				hx-swap="outerHTML"
				hx-push-url="true"
				if view.Tab == "exam" {
					aria-current="page"
				}
			>Экзамен</a>
			<a
				href="/questions"
				hx-get="/questions"
				hx-target="#content"
				hx-swap="outerHTML"
				hx-push-url="true"
				if view.Tab == "questions" {
					aria-current="page"
				}
			>Все вопросы</a>
			<a
				href="/lectures"
				hx-get="/lectures"
				hx-target="#content"
				hx-swap="outerHTML"
				hx-push-url="true"
				if view.Tab == "lectures" {
					aria-current="page"
				}
			>Конспекты</a>
		</nav>
		<h1>Вопросы по ТАУ</h1>
		if view.Error != "" {
			<p class="error" role="alert">{ view.Error }</p>
		}
		switch view.Tab {
			case "questions":
				@questionsTab(view)
			case "lectures":
				@lecturesTab(view.Lectures, view.Lecture)
			default:
				@examTab(view)
		}
	</main>
}

templ QuestionCard(q QuestionCardData) {
	{{
		title, givens, _ := strings.Cut(q.Question.Text, "\n")
		if q.Question.Format == "mathml" && strings.Count(title, "<math") > strings.Count(title, "</math>") {
			title, givens = q.Question.Text, ""
		}
	}}
	<article class="card" id={ q.AnchorID }>
		<h2 class={ "question-text", templ.KV("latex-source", q.Question.Format == "latex") }>
			if q.Number > 0 {
				{ fmt.Sprintf("%d. ", q.Number) }
			}
			@templ.Raw(renderQuestionContent(title, q.Question.Format))
		</h2>
		if givens != "" {
			<p class={ "question-givens", templ.KV("latex-source", q.Question.Format == "latex") }>@templ.Raw(renderQuestionContent(givens, q.Question.Format))</p>
		}
		<p class="meta">{ q.Question.Difficulty }</p>
		if q.Finished {
			<div class="user-answer">
				<strong>Ваш ответ</strong>
				if q.UserAnswer == "" {
					<p>Ответ не указан.</p>
				} else {
					<p>{ q.UserAnswer }</p>
				}
			</div>
			@AnswerBlock(q.Question)
		} else {
			if q.AttemptID != "" {
				<label class="user-answer">
					Ваш ответ<span class="visually-hidden">{ fmt.Sprintf(" на вопрос %d", q.Number) }</span>
					<textarea rows="3" name={ q.Question.ID } form="finish-exam" data-draft-key={ fmt.Sprintf("tau-exam:active:%s:%d:draft", q.AttemptID, q.Number) }></textarea>
				</label>
			}
			<details class="catalog-answer">
				<summary class="answer-toggle"><span class="catalog-show">Показать ответ</span><span class="catalog-hide">Скрыть ответ</span></summary>
				@AnswerBlock(q.Question)
			</details>
		}
	</article>
}

templ AnswerBlock(question model.Question) {
	<div class="answer revealed">
		<strong>Правильный ответ</strong>
		<p
			if question.Format == "latex" {
				class="latex-source"
			}
		>@templ.Raw(renderQuestionContent(question.Answer, question.Format))</p>
	</div>
}
