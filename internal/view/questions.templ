package views

import "github.com/AlexLopatin-hub/tau-exam-gym/internal/model"

templ questionsTab(view PageView) {
	<nav class="tabs" aria-label="Сложность вопросов">
		for _, difficulty := range model.Difficulties {
			<a
				href={ templ.URL("/questions?difficulty=" + difficulty.Slug) }
				hx-get={ "/questions?difficulty=" + difficulty.Slug }
				hx-target="#content"
				hx-swap="outerHTML"
				hx-push-url="true"
				if view.Difficulty == difficulty.Slug {
					aria-current="page"
				}
			>{ difficulty.Label }</a>
		}
	</nav>
	<div id="question-results">
		if len(view.Questions) == 0 {
			<p class="empty-state">В этом разделе пока нет вопросов.</p>
		}
		for i, q := range view.Questions {
			@QuestionCard(QuestionCardData{AnchorID: "question-" + q.ID, Number: i + 1, Question: q})
		}
	</div>
}
